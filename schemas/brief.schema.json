{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImageGenerationBrief",
  "type": "object",
  "required": [
    "task_id", "status", "use_case", "scene", "subject", "camera", "lighting",
    "materials", "composition", "style", "preserve", "constraints", "negative",
    "references", "task_card", "art_direction", "visual_plan", "craft_expansion"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["PROCEED", "PROCEED_WITH_ASSUMPTIONS", "NEEDS_REFERENCES", "NEEDS_USER_INPUT", "NOT_USEFUL", "BLOCKED"]
    },
    "use_case": {"type": "string"},
    "scene": {"type": "string"},
    "subject": {"type": "string"},
    "camera": {"type": "string"},
    "lighting": {"type": "string"},
    "materials": {"type": "string"},
    "composition": {"type": "string"},
    "style": {"type": "string"},
    "preserve": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "negative": {"type": "array", "items": {"type": "string"}},
    "references": {"type": "array", "items": {"type": "string"}},
    "task_card": {"type": "object"},
    "art_direction": {"type": "object"},
    "visual_plan": {"type": "object"},
    "craft_expansion": {"type": "object"}
  },
  "additionalProperties": false
}
