{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisualPlan",
  "type": "object",
  "required": [
    "direction_family",
    "visual_type",
    "concept",
    "scene_concept",
    "visual_breakdown",
    "shot_family",
    "spatial_layers",
    "composition",
    "lighting",
    "materials",
    "color_system",
    "style_tags",
    "quality_target",
    "generation_intent",
    "text_strategy",
    "constraint_pack",
    "prompt_layers",
    "concept_candidates",
    "selected_concept_id",
    "reference_anchors",
    "human_checklist"
  ],
  "properties": {
    "direction_family": {"type": "string"},
    "visual_type": {"type": "string"},
    "concept": {"type": "string"},
    "scene": {"type": "string"},
    "scene_concept": {"type": "string"},
    "visual_breakdown": {
      "type": "object",
      "required": [
        "subject",
        "action_pose",
        "details_appearance",
        "environment_background",
        "lighting_atmosphere",
        "composition_framing",
        "style_camera",
        "colors",
        "materials",
        "aspect_ratio",
        "quality_finish",
        "generation_intent"
      ],
      "properties": {
        "subject": {"type": "string"},
        "action_pose": {"type": "string"},
        "details_appearance": {"type": "string"},
        "environment_background": {"type": "string"},
        "lighting_atmosphere": {"type": "string"},
        "composition_framing": {"type": "string"},
        "style_camera": {"type": "string"},
        "colors": {"type": "array", "items": {"type": "string"}},
        "materials": {"type": "array", "items": {"type": "string"}},
        "aspect_ratio": {"type": "string"},
        "quality_finish": {"type": "string"},
        "generation_intent": {"type": "string"},
        "spatial_layers": {
          "type": "object",
          "required": ["foreground", "midground", "background"],
          "properties": {
            "foreground": {"type": "string"},
            "midground": {"type": "string"},
            "background": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "shot_family": {"type": "string"},
    "spatial_layers": {
      "type": "object",
      "required": ["foreground", "midground", "background"],
      "properties": {
        "foreground": {"type": "string"},
        "midground": {"type": "string"},
        "background": {"type": "string"}
      },
      "additionalProperties": false
    },
    "composition": {"type": "string"},
    "lighting": {"type": "string"},
    "materials": {"type": "string"},
    "color_system": {"type": "array", "items": {"type": "string"}},
    "style_tags": {"type": "array", "items": {"type": "string"}},
    "quality_target": {"type": "string"},
    "generation_intent": {"type": "string"},
    "text_rule": {"type": "string"},
    "text_strategy": {"type": "string"},
    "hard_constraints": {"type": "array", "items": {"type": "string"}},
    "constraint_pack": {"type": "array", "items": {"type": "string"}},
    "prompt_layers": {
      "type": "object",
      "required": ["prompt_core", "recreation_prompt", "negative_prompt"],
      "properties": {
        "prompt_core": {"type": "string"},
        "recreation_prompt": {"type": "string"},
        "negative_prompt": {"type": "string"}
      },
      "additionalProperties": false
    },
    "concept_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "concept_id",
          "visual_solution",
          "why_it_fits",
          "first_read",
          "second_read",
          "text_risk",
          "reference_risk",
          "thumbnail_readability",
          "score",
          "selected"
        ],
        "properties": {
          "concept_id": {"type": "string"},
          "visual_solution": {"type": "string"},
          "why_it_fits": {"type": "string"},
          "first_read": {"type": "string"},
          "second_read": {"type": "string"},
          "text_risk": {"type": "string"},
          "reference_risk": {"type": "string"},
          "thumbnail_readability": {"type": "string"},
          "score": {"type": "integer"},
          "selected": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "selected_concept_id": {"type": "string"},
    "reference_anchors": {
      "type": "object",
      "required": ["identity", "palette", "lighting", "composition", "material", "forbidden_drift"],
      "properties": {
        "identity": {"type": "array", "items": {"type": "string"}},
        "palette": {"type": "array", "items": {"type": "string"}},
        "lighting": {"type": "array", "items": {"type": "string"}},
        "composition": {"type": "array", "items": {"type": "string"}},
        "material": {"type": "array", "items": {"type": "string"}},
        "forbidden_drift": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "human_checklist": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
