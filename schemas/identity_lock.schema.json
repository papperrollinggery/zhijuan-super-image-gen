{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IdentityLock",
  "type": "object",
  "required": ["scope", "source_of_truth", "references", "anchors", "forbidden_drift"],
  "properties": {
    "scope": {
      "type": "string",
      "enum": ["person_or_character", "product", "ui_system", "brand_style", "visual_style"]
    },
    "source_of_truth": {
      "type": "string",
      "enum": ["provided_references", "explicit_user_description"]
    },
    "references": {"type": "array", "items": {"type": "string"}},
    "anchors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_drift": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
